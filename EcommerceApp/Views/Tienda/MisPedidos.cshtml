@model List<EcommerceApp.Models.Pedido>
@{
    ViewData["Title"] = "Mis Pedidos — TechParts";
    bool isStaff = (bool)(ViewBag.IsStaff ?? false);
}

<style>
    body { background: #080a14 !important; }
    .ped-page { max-width: 1000px; margin: 2rem auto; padding: 0 1.5rem 4rem; }
    .ped-header h1 { color: #fff; font-weight: 800; font-size: 1.8rem; margin: 0 0 .3rem; }
    .ped-header p  { color: rgba(255,255,255,.4); font-size: .9rem; }

    .clock-bar {
        background: rgba(108,99,255,.08); border: 1px solid rgba(108,99,255,.2);
        border-radius: 12px; padding: .65rem 1.25rem; margin: 1.25rem 0;
        display: flex; align-items: center; gap: .75rem;
        font-size: .85rem; color: rgba(200,200,255,.7);
    }
    .clock-bar #reloj { color: #00d9b5; font-weight: 800; font-size: 1rem; font-variant-numeric: tabular-nums; }

    /* Stats */
    .ped-stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; margin: 1.5rem 0; }
    @@media(max-width:600px){ .ped-stats { grid-template-columns: repeat(2,1fr); } }
    .stat-card {
        background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08);
        border-radius: 14px; padding: 1rem 1.25rem; text-align: center;
    }
    .stat-card .stat-num { font-size: 1.5rem; font-weight: 900; color: #fff; }
    .stat-card .stat-lbl { font-size: .72rem; color: rgba(255,255,255,.4); margin-top: .2rem; }
    .stat-card.violet .stat-num { background: linear-gradient(135deg,#6c63ff,#a78bfa);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat-card.teal .stat-num { background: linear-gradient(135deg,#00d9b5,#06d6a0);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat-card.amber .stat-num { color: #fbbf24; }
    .stat-card.red .stat-num { color: #f87171; }

    /* Tabla */
    .ped-table-wrap { overflow-x: auto; }
    .ped-table { width: 100%; border-collapse: collapse; }
    .ped-table thead tr { background: rgba(108,99,255,.08); }
    .ped-table th { padding: .75rem 1rem; text-align: left; font-size: .72rem;
        font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
        color: rgba(200,200,255,.5); border-bottom: 1px solid rgba(108,99,255,.15); white-space: nowrap; }
    .ped-table td { padding: .85rem 1rem; font-size: .88rem;
        color: rgba(255,255,255,.75); border-bottom: 1px solid rgba(255,255,255,.05); }
    .ped-table tbody tr:hover td { background: rgba(255,255,255,.02); }

    .num-pedido { font-weight: 700; color: #a78bfa; font-family: monospace; }
    .hora-cell { color: #00d9b5; font-weight: 700; font-size: .8rem; }

    .estado-badge { display: inline-block; padding: .2rem .65rem; border-radius: 30px;
        font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
    .e-completado { background: rgba(16,185,129,.15); color: #34d399; border: 1px solid rgba(16,185,129,.3); }
    .e-devuelto   { background: rgba(239,68,68,.15);  color: #f87171; border: 1px solid rgba(239,68,68,.3); }
    .e-pendiente  { background: rgba(245,158,11,.15); color: #fbbf24; border: 1px solid rgba(245,158,11,.3); }

    .metodo-tag { font-size: .75rem; color: rgba(255,255,255,.45); }

    .btn-ver { background: rgba(108,99,255,.2); border: 1px solid rgba(108,99,255,.3);
        color: #a78bfa; border-radius: 8px; padding: .3rem .7rem;
        font-size: .78rem; font-weight: 700; text-decoration: none; transition: all .2s; }
    .btn-ver:hover { background: rgba(108,99,255,.35); color: #c4b5fd; }
    .btn-devolver { background: rgba(239,68,68,.08); border: 1px solid rgba(239,68,68,.2);
        color: #f87171; border-radius: 8px; padding: .3rem .7rem;
        font-size: .72rem; font-weight: 700; cursor: pointer; transition: all .2s; }
    .btn-devolver:hover { background: rgba(239,68,68,.18); }

    .empty-state { text-align: center; padding: 4rem 2rem; color: rgba(255,255,255,.4); }
    .empty-state .icon { font-size: 3.5rem; margin-bottom: 1rem; }

    .alert-tp  { background:rgba(16,185,129,.1); border:1px solid rgba(16,185,129,.3); border-radius:12px; padding:.85rem 1.25rem; color:#34d399; font-size:.88rem; margin-bottom:1.25rem; }
    .alert-err { background:rgba(239,68,68,.08); border:1px solid rgba(239,68,68,.25); border-radius:12px; padding:.85rem 1.25rem; color:#f87171; font-size:.88rem; margin-bottom:1.25rem; }
</style>

<div class="ped-page">
    <div class="ped-header">
        <h1>📦 @(isStaff ? "Todos los Pedidos" : "Mis Pedidos")</h1>
        <p>Historial de compras con hora exacta de cada transacción</p>
    </div>

    @if (TempData["Exito"] != null) { <div class="alert-tp">✓ @TempData["Exito"]</div> }
    @if (TempData["Error"] != null) { <div class="alert-err">⚠ @TempData["Error"]</div> }

    <!-- Reloj en tiempo real -->
    <div class="clock-bar">
        🕐 Hora actual: <span id="reloj">--:--:--</span>
        &nbsp;·&nbsp; Todos los pedidos muestran la hora exacta de la transacción
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="icon">📦</div>
            <p>Aún no tienes pedidos.</p>
            <a asp-controller="Tienda" asp-action="Index"
               style="background:linear-gradient(135deg,#6c63ff,#574fd6);color:#fff;
               padding:.7rem 1.5rem;border-radius:12px;text-decoration:none;font-weight:700;">
               Ver Tienda
            </a>
        </div>
    }
    else
    {
        <!-- Stats rápidos -->
        var total = Model.Sum(p => p.Total);
        var completados = Model.Count(p => p.Estado == EcommerceApp.Models.EstadoPedido.Completado);
        var devueltos = Model.Count(p => p.Estado == EcommerceApp.Models.EstadoPedido.Devuelto);
        <div class="ped-stats">
            <div class="stat-card violet">
                <div class="stat-num">@Model.Count</div>
                <div class="stat-lbl">Total pedidos</div>
            </div>
            <div class="stat-card teal">
                <div class="stat-num">$@total.ToString("N0")</div>
                <div class="stat-lbl">Valor total</div>
            </div>
            <div class="stat-card amber">
                <div class="stat-num">@completados</div>
                <div class="stat-lbl">Completados</div>
            </div>
            <div class="stat-card red">
                <div class="stat-num">@devueltos</div>
                <div class="stat-lbl">Devueltos</div>
            </div>
        </div>

        <div class="ped-table-wrap">
            <table class="ped-table">
                <thead>
                    <tr>
                        <th>Nº Pedido</th>
                        @if (isStaff) { <th>Cliente</th> }
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Método</th>
                        <th>Items</th>
                        <th style="text-align:right">Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><span class="num-pedido">@p.NumeroPedido</span></td>
                            @if (isStaff)
                            {
                                <td>@(p.Usuario?.NombreCompleto ?? p.Usuario?.Email ?? "—")</td>
                            }
                            <td>@p.FechaPedido.ToString("dd/MM/yyyy")</td>
                            <td><span class="hora-cell">🕐 @p.FechaPedido.ToString("HH:mm:ss")</span></td>
                            <td>
                                <span class="metodo-tag">
                                    @(p.MetodoPago == EcommerceApp.Models.MetodoPago.Tarjeta ? "💳" :
                                      p.MetodoPago == EcommerceApp.Models.MetodoPago.Efectivo ? "💵" : "🏦")
                                    @p.MetodoPago
                                </span>
                            </td>
                            <td>@p.Items.Count ítem(s)</td>
                            <td style="text-align:right;font-weight:700;color:#fff;">
                                $@p.Total.ToString("N2")
                            </td>
                            <td>
                                @if (p.Estado == EcommerceApp.Models.EstadoPedido.Completado)
                                { <span class="estado-badge e-completado">✓ Completado</span> }
                                else if (p.Estado == EcommerceApp.Models.EstadoPedido.Devuelto)
                                { <span class="estado-badge e-devuelto">↩ Devuelto</span> }
                                else
                                { <span class="estado-badge e-pendiente">⏳ Pendiente</span> }
                            </td>
                            <td style="white-space:nowrap;">
                                <a asp-action="Factura" asp-route-id="@p.Id" class="btn-ver">
                                    📄 Ver
                                </a>
                                @if (p.Estado == EcommerceApp.Models.EstadoPedido.Completado)
                                {
                                    <form asp-action="SolicitarDevolucion" asp-route-id="@p.Id"
                                          method="post" style="display:inline;"
                                          onsubmit="return confirm('¿Confirmar devolución del pedido @p.NumeroPedido?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-devolver">↩</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script>
    function actualizarReloj() {
        const el = document.getElementById('reloj');
        if (el) {
            const now = new Date();
            el.textContent = now.toLocaleTimeString('es-MX', { hour12: false });
        }
    }
    actualizarReloj();
    setInterval(actualizarReloj, 1000);
</script>
}
