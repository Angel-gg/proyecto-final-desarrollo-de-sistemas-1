@model List<EcommerceApp.Models.Componente>
@{
    ViewData["Title"] = "TechParts Store — Tienda Online";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tipos = ViewBag.Tipos as List<string> ?? new List<string>();
    var tipoActual = ViewBag.TipoActual as string;
    var combos = ViewBag.Combos as List<EcommerceApp.Models.Combo> ?? new();
    var tab = ViewBag.Tab as string ?? "componentes";
    var carritoCount = (int)(ViewBag.CarritoCount ?? 0);
}

<style>
    :root { --primary:#6c63ff; --primary-dark:#574fd6; --accent:#00d9b5; --bg:#0d0f1a; }
    /* Let the global theme handle the body background */

    /* Hero */
    .store-hero {
        background: linear-gradient(135deg, #6c63ff 0%, #574fd6 55%, #00c9a7 100%);
        color: #fff; padding: 3rem 2rem 3.5rem; text-align: center; position: relative; overflow: hidden;
    }
    .store-hero::before { content:''; position:absolute; width:500px;height:500px;border-radius:50%; background:rgba(255,255,255,0.04); top:-200px;left:-100px; }
    .store-hero::after  { content:''; position:absolute; width:350px;height:350px;border-radius:50%; background:rgba(255,255,255,0.06); bottom:-120px;right:-50px; }
    .store-hero h1 { font-size:2.4rem; font-weight:800; margin-bottom:0.5rem; position:relative; z-index:1; }
    .store-hero p { opacity:0.85; font-size:1rem; position:relative; z-index:1; }
    .hero-stats { display:flex; justify-content:center; gap:2.5rem; margin-top:1.75rem; position:relative; z-index:1; }
    .hero-stat strong { display:block; font-size:1.5rem; font-weight:800; }
    .hero-stat span { font-size:0.8rem; opacity:0.75; }

    /* Tabs */
    .store-tabs {
        background: rgba(13,15,26,0.7); backdrop-filter: blur(10px); border-bottom:1px solid rgba(108,99,255,0.25);
        padding:0 1.5rem; display:flex; align-items:center; gap:0;
        position:sticky; top:62px; z-index:100;
        box-shadow:0 2px 12px rgba(0,0,0,0.06);
    }
    .tab-btn {
        padding:1rem 1.5rem; border:none; background:transparent;
        font-weight:700; font-size:0.9rem; color:#9ca3af; cursor:pointer;
        border-bottom:3px solid transparent; transition:all 0.18s; white-space:nowrap;
        text-decoration:none; display:flex; align-items:center; gap:0.4rem;
    }
    .tab-btn:hover { color:#6c63ff; }
    .tab-btn.active { color:#6c63ff; border-bottom-color:#6c63ff; }
    .tab-count { background:rgba(108,99,255,0.12); color:#6c63ff; font-size:0.72rem; font-weight:800; padding:0.15rem 0.5rem; border-radius:50px; }

    /* Category filter bar */
    .store-toolbar {
        background: rgba(13,15,26,0.5); backdrop-filter: blur(10px); border-bottom:1px solid rgba(108,99,255,0.25);
        padding:0.75rem 1.5rem; display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;
        position:sticky; top:113px; z-index:99;
    }
    .cat-btn {
        padding:0.35rem 0.85rem; border-radius:50px; border:1.5px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05); color:#e8eaf6; font-size:0.8rem; font-weight:600;
        cursor:pointer; text-decoration:none; transition:all 0.18s; white-space:nowrap;
    }
    .cat-btn:hover { border-color:var(--primary); color:var(--primary); }
    .cat-btn.active { background:var(--primary); border-color:var(--primary); color:#fff; }
    .toolbar-count { margin-left:auto; font-size:0.8rem; color:#9ca3af; }

    /* Products section */
    .products-section { padding:1.75rem 1.5rem 4rem; max-width:1400px; margin:0 auto; }

    /* CTA login */
    .login-cta {
        background:linear-gradient(135deg,rgba(108,99,255,0.1),rgba(0,217,181,0.08));
        border:1px solid rgba(108,99,255,0.3); border-radius:14px;
        padding:1.1rem 1.5rem; display:flex; align-items:center; justify-content:space-between;
        gap:1rem; margin-bottom:1.75rem; flex-wrap:wrap;
    }
    .login-cta p { margin:0; font-size:0.88rem; color:#fff; font-weight:500; }
    .login-cta a { background:var(--primary); color:#fff; padding:0.45rem 1.1rem; border-radius:8px; font-weight:700; font-size:0.82rem; text-decoration:none; white-space:nowrap; }

    /* Component grid */
    .product-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); gap:1.4rem; }
    .product-card {
        background: rgba(13,15,26,0.7); backdrop-filter: blur(10px); border-radius:16px; box-shadow:0 4px 20px rgba(0,0,0,0.5);
        overflow:hidden; display:flex; flex-direction:column;
        border:1px solid rgba(108,99,255,0.07); transition:transform 0.22s,box-shadow 0.22s;
    }
    .product-card:hover { transform:translateY(-5px); box-shadow:0 14px 36px rgba(108,99,255,0.17); }
    .product-img { height:190px; overflow:hidden; background:linear-gradient(135deg,#e8eaff,#f0f9ff); position:relative; }
    .product-img img { width:100%;height:100%;object-fit:cover; transition:transform 0.35s; }
    .product-card:hover .product-img img { transform:scale(1.06); }
    .product-img-placeholder { height:100%;display:flex;align-items:center;justify-content:center;font-size:3.5rem;color:rgba(108,99,255,0.3); }
    .product-cat-badge { position:absolute;top:0.65rem;left:0.65rem;background:rgba(13,15,26,0.7);color:#fff;font-size:0.68rem;font-weight:700;letter-spacing:0.05em;padding:0.2rem 0.55rem;border-radius:50px;backdrop-filter:blur(4px); }
    .stock-badge { position:absolute;top:0.65rem;right:0.65rem;font-size:0.68rem;font-weight:700;padding:0.2rem 0.55rem;border-radius:50px; }
    .stock-badge.in  { background:rgba(16,185,129,0.15);color:#059669;border:1px solid rgba(16,185,129,0.3); }
    .stock-badge.low { background:rgba(245,158,11,0.15);color:#d97706;border:1px solid rgba(245,158,11,0.3); }
    .stock-badge.out { background:rgba(239,68,68,0.15);color:#dc2626;border:1px solid rgba(239,68,68,0.3); }
    .product-body { padding:1rem 1.1rem 1.1rem; display:flex;flex-direction:column;flex:1; }
    .product-name { font-weight:700;font-size:0.93rem;color:#fff;margin-bottom:0.3rem;line-height:1.3; }
    .product-brand { font-size:0.75rem;color:#9ca3af;margin-bottom:0.6rem; }
    .product-desc { font-size:0.78rem;color:rgba(255,255,255,0.6);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:0.8rem;flex:1; }
    .product-footer { display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-top:auto; }
    .product-price { font-size:1.2rem;font-weight:800;background:linear-gradient(135deg,var(--primary),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }
    .btn-add { background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;border:none;border-radius:9px;padding:0.45rem 0.9rem;font-size:0.8rem;font-weight:700;cursor:pointer;transition:opacity 0.2s,transform 0.1s;white-space:nowrap; }
    .btn-add:hover { opacity:0.88; }
    .btn-add:active { transform:scale(0.97); }
    .btn-add:disabled { opacity:0.4;cursor:not-allowed; }

    /* Combos grid */
    .combos-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.4rem; }
    .combo-card {
        background: rgba(13,15,26,0.7); backdrop-filter: blur(10px); border-radius:16px;box-shadow:0 4px 20px rgba(0,0,0,0.5);
        overflow:hidden;display:flex;flex-direction:column;
        border:1px solid rgba(0,217,181,0.1);transition:transform 0.22s,box-shadow 0.22s;
    }
    .combo-card:hover { transform:translateY(-5px);box-shadow:0 14px 36px rgba(0,217,181,0.15); }
    .combo-img { height:190px;overflow:hidden;background:linear-gradient(135deg,#e0fdf4,#f0f9ff);position:relative; }
    .combo-img img { width:100%;height:100%;object-fit:cover;transition:transform 0.35s; }
    .combo-card:hover .combo-img img { transform:scale(1.05); }
    .combo-img-ph { height:100%;display:flex;align-items:center;justify-content:center;font-size:3.5rem;color:rgba(0,217,181,0.3); }
    .combo-badge-store { position:absolute;top:0.65rem;right:0.65rem;background:rgba(0,217,181,0.15);color:#059669;font-size:0.68rem;font-weight:700;padding:0.2rem 0.55rem;border-radius:50px;border:1px solid rgba(0,217,181,0.3); }
    .combo-body { padding:1rem 1.1rem 1.1rem;display:flex;flex-direction:column;flex:1; }
    .combo-name { font-weight:700;font-size:0.95rem;color:#fff;margin-bottom:0.3rem; }
    .combo-parts-count { font-size:0.75rem;color:#9ca3af;margin-bottom:0.6rem; }
    .combo-desc { font-size:0.78rem;color:rgba(255,255,255,0.6);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:0.8rem;flex:1; }
    .combo-footer { display:flex;align-items:center;justify-content:space-between;gap:0.5rem; }
    .combo-price { font-size:1.2rem;font-weight:800;background:linear-gradient(135deg,#00d9b5,#6c63ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }
    .btn-add-combo { background:linear-gradient(135deg,#00d9b5,#00a89a);color:#fff;border:none;border-radius:9px;padding:0.45rem 0.9rem;font-size:0.8rem;font-weight:700;cursor:pointer;transition:opacity 0.2s;white-space:nowrap; }
    .btn-add-combo:hover { opacity:0.85; }

    /* Empty */
    .empty-state { text-align:center;padding:4rem 2rem;color:rgba(255,255,255,0.5); }
    .empty-state .empty-icon { font-size:3.5rem;margin-bottom:1rem; }
    .empty-state h3 { font-size:1.1rem;color:#fff;margin-bottom:0.5rem; }
</style>

<!-- Hero -->
<div class="store-hero">
    <h1>🛒 TechParts Store</h1>
    <p>Componentes y combos de computación — disponibilidad en tiempo real</p>
    <div class="hero-stats">
        <div class="hero-stat"><strong>@Model.Count</strong><span>Componentes</span></div>
        <div class="hero-stat"><strong>@combos.Count</strong><span>Combos</span></div>
        <div class="hero-stat"><strong>@tipos.Count</strong><span>Categorías</span></div>
        @if (User.Identity!.IsAuthenticated && carritoCount > 0)
        {
            <div class="hero-stat">
                <strong>@carritoCount</strong>
                <span>En tu carrito</span>
            </div>
        }
    </div>
</div>

<!-- Tabs -->
<div class="store-tabs">
    <a href="@Url.Action("Index", new { tab = "componentes" })"
       class="tab-btn @(tab == "componentes" ? "active" : "")">
        🔧 Componentes <span class="tab-count">@Model.Count</span>
    </a>
    <a href="@Url.Action("Index", new { tab = "combos" })"
       class="tab-btn @(tab == "combos" ? "active" : "")">
        🎁 Combos <span class="tab-count">@combos.Count</span>
    </a>
    @if (User.Identity!.IsAuthenticated)
    {
        <a asp-controller="Tienda" asp-action="Carrito" class="tab-btn" style="margin-left:auto;">
            🛒 Mi carrito
            @if (carritoCount > 0)
            {
                <span class="tab-count" style="background:rgba(239,68,68,0.15);color:#dc2626;">@carritoCount</span>
            }
        </a>
    }
</div>

<!-- Category filter (solo en tab componentes) -->
@if (tab == "componentes")
{
    <div class="store-toolbar">
        <a href="@Url.Action("Index", new { tab = "componentes" })" class="cat-btn @(tipoActual == null ? "active" : "")">🔲 Todos</a>
        @foreach (var t in tipos)
        {
            <a href="@Url.Action("Index", new { tipo = t, tab = "componentes" })" class="cat-btn @(tipoActual == t ? "active" : "")">@t</a>
        }
        <span class="toolbar-count">@Model.Count producto(s)</span>
    </div>
}

<!-- Content -->
<div class="products-section">

    @if (!User.Identity!.IsAuthenticated)
    {
        <div class="login-cta">
            <p>🔒 <strong>Inicia sesión</strong> para agregar productos al carrito.</p>
            <a asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        </div>
    }

    @if (tab == "componentes")
    {
        @if (!Model.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h3>No hay componentes disponibles</h3>
                <p>@(tipoActual != null ? $"No hay productos en \"{tipoActual}\"." : "El catálogo está vacío.")</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var p in Model)
                {
                    <div class="product-card">
                        <div class="product-img">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Nombre" loading="lazy" />
                            }
                            else
                            {
                                <div class="product-img-placeholder">💻</div>
                            }
                            <span class="product-cat-badge">@p.Tipo</span>
                            @{
                                var sc = p.Stock > 10 ? "in" : p.Stock > 0 ? "low" : "out";
                                var st = p.Stock > 10 ? $"✓ {p.Stock}" : p.Stock > 0 ? $"⚠ {p.Stock}" : "✗ Agotado";
                            }
                            <span class="stock-badge @sc">@st</span>
                        </div>
                        <div class="product-body">
                            <div class="product-name">@p.Nombre</div>
                            @if (!string.IsNullOrEmpty(p.Marca)) { <div class="product-brand">@p.Marca</div> }
                            <div class="product-desc">@p.Descripcion</div>
                            <div class="product-footer">
                                <div class="product-price">Bs.@p.Precio.ToString("N2")</div>
                                @if (User.Identity!.IsAuthenticated && p.Stock > 0)
                                {
                                    <form asp-action="AgregarAlCarrito" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <input type="hidden" name="tipo" value="componente" />
                                        <button type="submit" class="btn-add">🛒 Agregar</button>
                                    </form>
                                }
                                else if (p.Stock == 0)
                                {
                                    <button class="btn-add" disabled>Agotado</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @if (!combos.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">🎁</div>
                <h3>No hay combos disponibles</h3>
                <p>Próximamente habrá paquetes especiales aquí.</p>
            </div>
        }
        else
        {
            <div class="combos-grid">
                @foreach (var c in combos)
                {
                    <div class="combo-card">
                        <div class="combo-img">
                            @if (!string.IsNullOrEmpty(c.ImageUrl))
                            {
                                <img src="@c.ImageUrl" alt="@c.Nombre" loading="lazy" />
                            }
                            else
                            {
                                <div class="combo-img-ph">🎁</div>
                            }
                            <span class="combo-badge-store">🎁 Combo</span>
                        </div>
                        <div class="combo-body">
                            <div class="combo-name">@c.Nombre</div>
                            <div class="combo-parts-count">📦 @c.ComboComponentes.Count componente(s)</div>
                            <div class="combo-desc">@c.Descripcion</div>
                            <div class="combo-footer">
                                <div class="combo-price">Bs.@c.PrecioVenta.ToString("N2")</div>
                                @if (User.Identity!.IsAuthenticated)
                                {
                                    <form asp-action="AgregarAlCarrito" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <input type="hidden" name="tipo" value="combo" />
                                        <button type="submit" class="btn-add-combo">🛒 Agregar</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <div class="text-center mt-5" style="font-size:0.8rem;color:#9ca3af;">
        📡 Inventario sincronizado en tiempo real con Supabase PostgreSQL
    </div>
</div>
