@model List<EcommerceApp.Models.Product>
@{
    ViewData["Title"] = "TechParts Store — Tienda Online";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var categoriaActual = ViewBag.CategoriaActual as string;
}

<style>
    :root {
        --primary: #6c63ff;
        --primary-dark: #574fd6;
        --accent: #00d9b5;
        --bg: #f0f2ff;
        --card-shadow: 0 4px 24px rgba(108,99,255,0.10);
    }

    body { background: var(--bg) !important; }

    /* ── Hero ── */
    .store-hero {
        background: linear-gradient(135deg, #6c63ff 0%, #574fd6 55%, #00c9a7 100%);
        color: #fff;
        padding: 3.5rem 2rem 4rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .store-hero::before {
        content: '';
        position: absolute;
        width: 600px; height: 600px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        top: -200px; left: -100px;
        pointer-events: none;
    }

    .store-hero::after {
        content: '';
        position: absolute;
        width: 400px; height: 400px;
        border-radius: 50%;
        background: rgba(255,255,255,0.06);
        bottom: -150px; right: -50px;
        pointer-events: none;
    }

    .store-hero h1 {
        font-size: 2.6rem;
        font-weight: 800;
        margin-bottom: 0.6rem;
        position: relative;
        z-index: 1;
    }

    .store-hero p {
        opacity: 0.85;
        font-size: 1.05rem;
        margin-bottom: 0;
        position: relative;
        z-index: 1;
    }

    .hero-stats {
        display: flex;
        justify-content: center;
        gap: 2.5rem;
        margin-top: 2rem;
        position: relative;
        z-index: 1;
    }

    .hero-stat {
        text-align: center;
    }

    .hero-stat strong {
        display: block;
        font-size: 1.6rem;
        font-weight: 800;
    }

    .hero-stat span {
        font-size: 0.82rem;
        opacity: 0.75;
    }

    /* ── Toolbar ── */
    .store-toolbar {
        background: #fff;
        border-bottom: 1px solid rgba(108,99,255,0.12);
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        position: sticky;
        top: 62px;
        z-index: 100;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    .cat-btn {
        padding: 0.45rem 1rem;
        border-radius: 50px;
        border: 1.5px solid #e5e7eb;
        background: #f9fafb;
        color: #374151;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.18s;
        white-space: nowrap;
    }

    .cat-btn:hover {
        border-color: var(--primary);
        color: var(--primary);
        background: rgba(108,99,255,0.06);
    }

    .cat-btn.active {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .toolbar-count {
        margin-left: auto;
        font-size: 0.82rem;
        color: #9ca3af;
        white-space: nowrap;
    }

    /* ── Product grid ── */
    .products-section {
        padding: 2rem 1.5rem 4rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
    }

    .product-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        border: 1px solid rgba(108,99,255,0.07);
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(108,99,255,0.18);
    }

    .product-img {
        height: 200px;
        overflow: hidden;
        background: linear-gradient(135deg, #e8eaff 0%, #f0f9ff 100%);
        position: relative;
    }

    .product-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.35s ease;
    }

    .product-card:hover .product-img img {
        transform: scale(1.06);
    }

    .product-img-placeholder {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: rgba(108,99,255,0.3);
    }

    .product-cat-badge {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        background: rgba(13,15,26,0.75);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 0.25rem 0.65rem;
        border-radius: 50px;
        backdrop-filter: blur(4px);
    }

    .stock-badge {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.25rem 0.65rem;
        border-radius: 50px;
    }

    .stock-badge.in { background: rgba(16,185,129,0.15); color: #059669; border: 1px solid rgba(16,185,129,0.3); }
    .stock-badge.low { background: rgba(245,158,11,0.15); color: #d97706; border: 1px solid rgba(245,158,11,0.3); }
    .stock-badge.out { background: rgba(239,68,68,0.15); color: #dc2626; border: 1px solid rgba(239,68,68,0.3); }

    .product-body {
        padding: 1.1rem 1.25rem 1.25rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .product-name {
        font-weight: 700;
        font-size: 0.97rem;
        color: #111827;
        margin-bottom: 0.4rem;
        line-height: 1.35;
    }

    .product-desc {
        font-size: 0.8rem;
        color: #6b7280;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 0.9rem;
        flex: 1;
    }

    .product-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-top: auto;
    }

    .product-price {
        font-size: 1.3rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
    }

    .btn-add {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.5rem 1rem;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.1s;
        white-space: nowrap;
    }

    .btn-add:hover { opacity: 0.88; }
    .btn-add:active { transform: scale(0.97); }
    .btn-add:disabled { opacity: 0.4; cursor: not-allowed; }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        color: #9ca3af;
    }
    .empty-state .empty-icon { font-size: 4rem; margin-bottom: 1rem; }
    .empty-state h3 { font-size: 1.2rem; color: #374151; margin-bottom: 0.5rem; }

    /* ── Login CTA banner ── */
    .login-cta {
        background: linear-gradient(135deg, rgba(108,99,255,0.08), rgba(0,217,181,0.06));
        border: 1px solid rgba(108,99,255,0.18);
        border-radius: 16px;
        padding: 1.25rem 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }
    .login-cta p { margin: 0; font-size: 0.9rem; color: #374151; font-weight: 500; }
    .login-cta a {
        background: var(--primary);
        color: #fff;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.85rem;
        text-decoration: none;
        white-space: nowrap;
        transition: opacity 0.2s;
    }
    .login-cta a:hover { opacity: 0.85; }
</style>

<!-- ── Hero ── -->
<div class="store-hero">
    <h1>🛒 TechParts Store</h1>
    <p>Componentes y periféricos de computación — disponibilidad en tiempo real</p>
    <div class="hero-stats">
        <div class="hero-stat">
            <strong>@Model.Count</strong>
            <span>Productos</span>
        </div>
        <div class="hero-stat">
            <strong>@categorias.Count</strong>
            <span>Categorías</span>
        </div>
        <div class="hero-stat">
            <strong>3</strong>
            <span>Sucursales</span>
        </div>
    </div>
</div>

<!-- ── Category toolbar ── -->
<div class="store-toolbar">
    <a href="@Url.Action("Index", "Tienda")"
       class="cat-btn @(categoriaActual == null ? "active" : "")">
        🔲 Todo
    </a>
    @foreach (var cat in categorias)
    {
        <a href="@Url.Action("Index", "Tienda", new { categoria = cat })"
           class="cat-btn @(categoriaActual == cat ? "active" : "")">
            @cat
        </a>
    }
    <div class="toolbar-count">@Model.Count producto(s)</div>
</div>

<!-- ── Products ── -->
<div class="products-section">

    @if (!User.Identity!.IsAuthenticated)
    {
        <div class="login-cta">
            <p>🔒 <strong>Inicia sesión</strong> para agregar productos al carrito y realizar compras.</p>
            <a asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>
            <h3>No hay productos disponibles</h3>
            <p>@(categoriaActual != null ? $"No hay productos en la categoría \"{categoriaActual}\"." : "El catálogo está vacío por ahora.")</p>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in Model)
            {
                <div class="product-card">
                    <div class="product-img">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" alt="@p.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="product-img-placeholder">💻</div>
                        }
                        <span class="product-cat-badge">@p.Category</span>
                        @{
                            var stockClass = p.Stock > 10 ? "in" : p.Stock > 0 ? "low" : "out";
                            var stockText  = p.Stock > 10 ? $"✓ {p.Stock} disponibles"
                                           : p.Stock > 0  ? $"⚠️ Solo {p.Stock} restantes"
                                           : "✗ Agotado";
                        }
                        <span class="stock-badge @stockClass">@stockText</span>
                    </div>
                    <div class="product-body">
                        <div class="product-name">@p.Name</div>
                        <div class="product-desc">@p.Description</div>
                        <div class="product-footer">
                            <div class="product-price">$@p.Price.ToString("N2")</div>
                            <button class="btn-add" @(p.Stock == 0 ? "disabled" : "") id="add-@p.Id">
                                @(p.Stock > 0 ? "🛒 Agregar" : "Agotado")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center mt-5" style="font-size:0.82rem; color:#9ca3af;">
        📡 Inventario sincronizado en tiempo real con Supabase PostgreSQL
    </div>
</div>
