@model List<EcommerceApp.Models.Componente>
@{
    ViewData["Title"] = "TechParts Store — Tienda Online";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tipos = ViewBag.Tipos as List<string> ?? new List<string>();
    var tipoActual = ViewBag.TipoActual as string;
    var combos = ViewBag.Combos as List<EcommerceApp.Models.Combo> ?? new();
    var tab = ViewBag.Tab as string ?? "componentes";
    var carritoCount = (int)(ViewBag.CarritoCount ?? 0);
}

<style>
    :root { --primary:#6c63ff; --primary-dark:#574fd6; --accent:#00d9b5; --bg:#0b0f19; }
    
    /* Hero */
    .store-hero {
        background: linear-gradient(135deg, #0b0f19 0%, #0f172a 100%);
        color: #fff; padding: 4rem 2rem; position: relative; overflow: hidden;
        border-bottom: 1px solid rgba(108,99,255,0.15);
    }
    .store-hero::before { content:''; position:absolute; width:600px;height:600px;border-radius:50%; background:radial-gradient(circle, rgba(108,99,255,0.15) 0%, transparent 70%); top:-200px;left:-100px; }
    .store-hero::after  { content:''; position:absolute; width:450px;height:450px;border-radius:50%; background:radial-gradient(circle, rgba(0,217,181,0.15) 0%, transparent 70%); bottom:-150px;right:-50px; }
    
    .hero-content { position: relative; z-index: 2; max-width: 1400px; margin: 0 auto; }
    .hero-title { font-size:3.2rem; font-weight:900; margin-bottom:1rem; letter-spacing: -0.03em; line-height: 1.1; }
    .hero-subtitle { opacity:0.8; font-size:1.15rem; margin-bottom: 2rem; max-width: 500px; line-height: 1.6; }
    
    .hero-cta {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: #fff; text-decoration: none; font-weight: 700; padding: 0.85rem 2.5rem; border-radius: 50px;
        transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 15px rgba(108,99,255,0.4);
    }
    .hero-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(108,99,255,0.6); color: #fff; }
    
    .trust-badges { display: flex; gap: 1.5rem; margin-top: 2rem; flex-wrap: wrap; }
    .trust-badge { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 600; color: #94a3b8; }
    .trust-badge span { color: var(--accent); font-size: 1.1rem; }

    .hero-img-container { position: relative; text-align: center; }
    .hero-img-container img { max-width: 100%; max-height: 400px; object-fit: contain; filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5)); transform: perspective(1000px) rotateY(-15deg); transition: transform 0.5s; }
    .hero-img-container:hover img { transform: perspective(1000px) rotateY(0deg); }

    /* Tabs */
    .store-tabs {
        background: rgba(11,15,25,0.85); backdrop-filter: blur(12px); border-bottom:1px solid rgba(108,99,255,0.25);
        padding:0 1.5rem; display:flex; align-items:center; gap:0;
        position:sticky; top:62px; z-index:100;
        box-shadow:0 2px 12px rgba(0,0,0,0.2);
        overflow-x: auto; white-space: nowrap; -ms-overflow-style: none; scrollbar-width: none;
    }
    .store-tabs::-webkit-scrollbar { display: none; }
    .tab-btn {
        padding:1rem 1.5rem; border:none; background:transparent;
        font-weight:700; font-size:0.95rem; color:#94a3b8; cursor:pointer;
        border-bottom:3px solid transparent; transition:all 0.18s; white-space:nowrap;
        text-decoration:none; display:flex; align-items:center; gap:0.5rem;
    }
    .tab-btn:hover { color:#fff; }
    .tab-btn.active { color:var(--primary); border-bottom-color:var(--primary); }
    .tab-count { background:rgba(108,99,255,0.15); color:#a78bfa; font-size:0.75rem; font-weight:800; padding:0.15rem 0.5rem; border-radius:50px; }

    /* Layout */
    .catalog-layout { display: flex; gap: 2rem; padding: 2rem 1.5rem 4rem; max-width: 1400px; margin: 0 auto; align-items: flex-start; }
    .catalog-sidebar { width: 260px; flex-shrink: 0; position: sticky; top: 130px; }
    .catalog-content { flex: 1; min-width: 0; }
    
    @@media (max-width: 991px) { 
        .catalog-layout { flex-direction: column; } 
        .catalog-sidebar { width: 100%; position: static; } 
        .hero-title { font-size: 2.2rem; }
        .hero-img-container img { transform: none; max-height: 300px; margin-top: 2rem; }
    }

    /* Sidebar Styles */
    .filter-card { background: #1e293b; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); padding: 1.5rem; margin-bottom: 1.5rem; }
    .filter-title { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    
    .cat-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.4rem; }
    .cat-link { 
        display: flex; justify-content: space-between; align-items: center; 
        padding: 0.5rem 0.75rem; border-radius: 8px; color: #94a3b8; 
        text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: all 0.2s; 
    }
    .cat-link:hover { background: rgba(255,255,255,0.05); color: #fff; }
    .cat-link.active { background: rgba(108,99,255,0.15); color: var(--primary); border: 1px solid rgba(108,99,255,0.3); }

    /* CTA login */
    .login-cta {
        background:linear-gradient(135deg,rgba(108,99,255,0.1),rgba(0,217,181,0.08));
        border:1px solid rgba(108,99,255,0.3); border-radius:12px;
        padding:1.1rem 1.5rem; display:flex; align-items:center; justify-content:space-between;
        gap:1rem; margin-bottom:1.75rem; flex-wrap:wrap;
    }
    .login-cta p { margin:0; font-size:0.9rem; color:#fff; font-weight:500; }
    .login-cta a { background:var(--primary); color:#fff; padding:0.5rem 1.25rem; border-radius:8px; font-weight:700; font-size:0.85rem; text-decoration:none; white-space:nowrap; }

    /* Component grid - 100% Dark Mode */
    .product-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:1.5rem; }
    .product-card {
        background: #1e293b; border-radius: 1rem; overflow: hidden; display: flex; flex-direction: column;
        border: 1px solid rgba(255,255,255,0.08); transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
        position: relative;
    }
    .product-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.4), 0 0 20px rgba(108,99,255,0.15); border-color: rgba(108,99,255,0.4); }
    
    .product-img { height: 210px; padding: 1.5rem; display: flex; align-items: center; justify-content: center; position: relative; background: #151e2e; }
    .product-img img { max-width: 100%; max-height: 100%; object-fit: contain; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5)); transition: transform 0.4s; }
    .product-card:hover .product-img img { transform: scale(1.1); }
    
    .product-img-placeholder { font-size:4rem; color:rgba(255,255,255,0.1); filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5)); }
    .product-cat-badge { position:absolute;top:0.75rem;left:0.75rem;background:rgba(108,99,255,0.2);color:#c4b5fd;font-size:0.65rem;font-weight:700;letter-spacing:0.05em;padding:0.25rem 0.6rem;border-radius:6px;border:1px solid rgba(108,99,255,0.3); text-transform: uppercase; }
    
    .product-body { padding: 1.25rem; display: flex; flex-direction: column; flex: 1; background: #1e293b; }
    .product-brand { font-size:0.7rem; color:#94a3b8; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.3rem; }
    .product-name { font-weight:700; font-size:0.95rem; color:#f8fafc; line-height:1.4; margin-bottom:0.5rem; display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden; }
    
    .product-specs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
    .micro-spec { font-size: 0.68rem; font-weight: 600; color: #cbd5e1; background: rgba(255,255,255,0.08); padding: 0.15rem 0.4rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.05); }

    .product-footer { display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-top:auto; }
    .product-price { font-size:1.35rem;font-weight:800;color:#fff; letter-spacing: -0.02em; }
    
    .btn-add { 
        background: linear-gradient(135deg, var(--accent), #00a89a); color: #0f172a; border: none;
        border-radius:8px; padding:0.45rem 0.9rem; font-size:0.85rem; font-weight:800; cursor:pointer; 
        transition:all 0.2s; display: flex; align-items: center; gap: 0.4rem; box-shadow: 0 4px 10px rgba(0,217,181,0.3);
    }
    .btn-add:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,217,181,0.4); }
    .btn-add:active { transform:scale(0.95); }
    .btn-add:disabled { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.3); box-shadow: none; cursor:not-allowed; }

    /* Mobile specific layout (1 column, image left, text right) */
    @@media (max-width: 576px) {
        .product-grid { grid-template-columns: 1fr; gap: 1rem; }
        .product-card { flex-direction: row; height: 150px; }
        .product-img { width: 140px; height: 100%; padding: 0.75rem; border-right: 1px solid rgba(255,255,255,0.05); border-bottom: none; }
        .product-body { padding: 0.8rem; justify-content: space-between; }
        .product-name { font-size: 0.85rem; margin-bottom: 0.2rem; }
        .product-price { font-size: 1.15rem; }
        .btn-add { padding: 0.35rem 0.75rem; font-size: 0.75rem; }
        .product-cat-badge { display: none; }
        .product-specs { display: none; }
    }

    /* Combos grid */
    .combos-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem; }
    .combo-card {
        background: #1e293b; border-radius: 1rem; overflow:hidden; display:flex; flex-direction:column;
        border:1px solid rgba(0,217,181,0.2); transition:transform 0.25s,box-shadow 0.25s; position: relative;
    }
    .combo-card:hover { transform:translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.4), 0 0 20px rgba(0,217,181,0.15); }
    .combo-img { height: 210px; overflow:hidden; background:#151e2e; position:relative; display: flex; align-items: center; justify-content: center; padding: 1.5rem; }
    .combo-img img { max-width:100%; max-height:100%; object-fit:contain; filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5)); transition:transform 0.4s; }
    .combo-card:hover .combo-img img { transform:scale(1.1); }
    .combo-img-ph { font-size:4rem;color:rgba(0,217,181,0.2); filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5)); }
    .combo-badge-store { position:absolute;top:0.75rem;left:0.75rem;background:rgba(0,217,181,0.2);color:#34d399;font-size:0.65rem;font-weight:700;padding:0.25rem 0.6rem;border-radius:6px;border:1px solid rgba(0,217,181,0.3); text-transform: uppercase; }
    
    .combo-body { padding:1.25rem;display:flex;flex-direction:column;flex:1; }
    .combo-name { font-weight:800;font-size:1rem;color:#f8fafc;margin-bottom:0.4rem; }
    .combo-parts-count { font-size:0.75rem;font-weight:600;color:#94a3b8;margin-bottom:0.6rem; }
    .combo-desc { font-size:0.8rem;color:#cbd5e1;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:1rem;flex:1; }
    
    .combo-footer { display:flex;align-items:center;justify-content:space-between;gap:0.5rem; }
    .combo-price { font-size:1.35rem;font-weight:800;color:#fff; }
    .btn-add-combo { background:linear-gradient(135deg,#00d9b5,#00a89a);color:#0f172a;border:none;border-radius:8px;padding:0.45rem 0.9rem;font-size:0.85rem;font-weight:800;cursor:pointer;transition:all 0.2s;white-space:nowrap;box-shadow: 0 4px 10px rgba(0,217,181,0.3); display: flex; align-items: center; gap: 0.4rem; }
    .btn-add-combo:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,217,181,0.4); }

    /* Empty */
    .empty-state { text-align:center;padding:4rem 2rem;color:rgba(255,255,255,0.5); background: #1e293b; border-radius: 1rem; border: 1px dashed rgba(255,255,255,0.1); }
    .empty-state .empty-icon { font-size:3.5rem;margin-bottom:1rem; opacity: 0.5; }
    .empty-state h3 { font-size:1.1rem;color:#fff;margin-bottom:0.5rem; font-weight: 700; }
</style>

<!-- Hero -->
<div class="store-hero">
    <div class="hero-content row align-items-center">
        <div class="col-lg-6 text-start">
            <h1 class="hero-title">Domina el Juego. <br/><span style="color:var(--primary);">Arma tu PC Ideal.</span></h1>
            <p class="hero-subtitle">Descubre los componentes de hardware más extremos del mercado. Envíos a todo el país y garantía oficial directa de fábrica.</p>
            <a href="#catalogo" class="hero-cta">🚀 Explorar Catálogo</a>
            
            <div class="trust-badges">
                <div class="trust-badge"><span>🛡️</span> Garantía Oficial</div>
                <div class="trust-badge"><span>🚚</span> Envíos Rápidos</div>
                <div class="trust-badge"><span>⚙️</span> Soporte Experto</div>
            </div>
        </div>
        <div class="col-lg-6 mt-5 mt-lg-0">
            <div class="hero-img-container">
                <img src="/img/hero_gamer_pc.jpg" alt="PC Gamer Custom Liquid Cooling" style="border-radius: 1rem; object-fit: cover;" />
            </div>
        </div>
    </div>
</div>

<!-- Tabs -->
<div class="store-tabs">
    <a href="@Url.Action("Index", new { tab = "componentes" })"
       class="tab-btn @(tab == "componentes" ? "active" : "")">
        🔧 Componentes <span class="tab-count">@Model.Count</span>
    </a>
    <a href="@Url.Action("Index", new { tab = "combos" })"
       class="tab-btn @(tab == "combos" ? "active" : "")">
        🎁 Combos <span class="tab-count">@combos.Count</span>
    </a>
</div>

<!-- Layout Principal (Sidebar + Grid) -->
<div class="catalog-layout" id="catalogo">
    
    @if (tab == "componentes")
    {
        <!-- Sidebar Filtros -->
        <aside class="catalog-sidebar">
            <div class="filter-card">
                <h3 class="filter-title">Categorías</h3>
                <ul class="cat-list">
                    <li>
                        <a href="@Url.Action("Index", new { tab = "componentes" })" class="cat-link @(tipoActual == null ? "active" : "")">
                            <span>🔲 Todas</span>
                            <span style="font-size:0.75rem; background:rgba(255,255,255,0.1); padding:0.1rem 0.4rem; border-radius:50px;">@Model.Count</span>
                        </a>
                    </li>
                    @foreach (var t in tipos)
                    {
                        <li>
                            <a href="@Url.Action("Index", new { tipo = t, tab = "componentes" })" class="cat-link @(tipoActual == t ? "active" : "")">
                                <span>@t</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
            
            <div class="filter-card">
                <h3 class="filter-title">Garantía TechParts</h3>
                <p style="font-size:0.8rem; color:#94a3b8; line-height:1.5; margin:0;">
                    Todos nuestros productos cuentan con garantía directa de fábrica. Al comprar, adquieres hardware 100% original.
                </p>
            </div>
        </aside>
    }

    <!-- Contenido Principal -->
    <main class="catalog-content">
        @if (!User.Identity!.IsAuthenticated)
        {
            <div class="login-cta">
                <p>🔒 <strong>Inicia sesión</strong> para comprar hardware de alto rendimiento al instante.</p>
                <a asp-controller="Account" asp-action="Login">Iniciar sesión</a>
            </div>
        }

        @if (tab == "componentes")
        {
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">📦</div>
                    <h3>No hay componentes disponibles</h3>
                    <p>@(tipoActual != null ? $"No encontramos productos en la categoría \"{tipoActual}\"." : "El catálogo está vacío actualmente.")</p>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var p in Model)
                    {
                        <div class="product-card">
                            <div class="product-img">
                                @if (!string.IsNullOrEmpty(p.ImageUrl))
                                {
                                    <img src="@p.ImageUrl" alt="@p.Nombre" loading="lazy" />
                                }
                                else
                                {
                                    <div class="product-img-placeholder">💻</div>
                                }
                                <span class="product-cat-badge">@p.Tipo</span>
                            </div>
                            <div class="product-body">
                                @if (!string.IsNullOrEmpty(p.Marca)) { <div class="product-brand">@p.Marca</div> }
                                <div class="product-name">@p.Nombre</div>
                                
                                <!-- Micro Specs (Mocked for visual impact as requested) -->
                                <div class="product-specs">
                                    @{
                                        string tipoLower = p.Tipo?.ToLower() ?? "";
                                        if (tipoLower.Contains("ram") || tipoLower.Contains("memoria")) {
                                            <span class="micro-spec">DDR5</span><span class="micro-spec">6000MHz</span><span class="micro-spec">RGB</span>
                                        } else if (tipoLower.Contains("ssd") || tipoLower.Contains("almacenamiento")) {
                                            <span class="micro-spec">PCIe 4.0</span><span class="micro-spec">NVMe</span><span class="micro-spec">7000 MB/s</span>
                                        } else if (tipoLower.Contains("fuente")) {
                                            <span class="micro-spec">80 Plus Gold</span><span class="micro-spec">Modular</span>
                                        } else if (tipoLower.Contains("placa") || tipoLower.Contains("mother")) {
                                            <span class="micro-spec">AM5 / LGA1700</span><span class="micro-spec">WiFi 6E</span>
                                        } else if (tipoLower.Contains("tarjeta") || tipoLower.Contains("video") || tipoLower.Contains("gpu")) {
                                            <span class="micro-spec">GDDR6X</span><span class="micro-spec">Ray Tracing</span><span class="micro-spec">DLSS 3</span>
                                        } else {
                                            <span class="micro-spec">Premium</span><span class="micro-spec">Garantía 12m</span>
                                        }
                                    }
                                </div>
                                
                                <div class="product-footer">
                                    <div class="product-price">Bs.@p.Precio.ToString("N0")</div>
                                    @if (User.Identity!.IsAuthenticated && p.Stock > 0)
                                    {
                                        <form asp-action="AgregarAlCarrito" method="post" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="tipo" value="componente" />
                                            <button type="submit" class="btn-add">
                                                <span class="d-inline">🛒</span>
                                                <span class="d-none d-sm-inline">Agregar</span>
                                            </button>
                                        </form>
                                    }
                                    else if (p.Stock == 0)
                                    {
                                        <button class="btn-add" disabled>Agotado</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            @if (!combos.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">🎁</div>
                    <h3>No hay combos disponibles</h3>
                    <p>Próximamente habrá configuraciones especiales aquí.</p>
                </div>
            }
            else
            {
                <div class="combos-grid">
                    @foreach (var c in combos)
                    {
                        <div class="combo-card">
                            <div class="combo-img">
                                @if (!string.IsNullOrEmpty(c.ImageUrl))
                                {
                                    <img src="@c.ImageUrl" alt="@c.Nombre" loading="lazy" />
                                }
                                else
                                {
                                    <div class="combo-img-ph">🎁</div>
                                }
                                <span class="combo-badge-store">Combo</span>
                            </div>
                            <div class="combo-body">
                                <div class="combo-name">@c.Nombre</div>
                                <div class="combo-parts-count">📦 @c.ComboComponentes.Count componentes incluidos</div>
                                <div class="combo-desc">@c.Descripcion</div>
                                <div class="combo-footer">
                                    <div class="combo-price">Bs.@c.PrecioVenta.ToString("N2")</div>
                                    @if (User.Identity!.IsAuthenticated)
                                    {
                                        <form asp-action="AgregarAlCarrito" method="post" style="margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@c.Id" />
                                            <input type="hidden" name="tipo" value="combo" />
                                            <button type="submit" class="btn-add-combo">
                                                <span class="d-inline">🛒</span>
                                                <span>Agregar</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <div class="text-center mt-5" style="font-size:0.8rem;color:#64748b; font-weight:600;">
            📡 Inventario sincronizado en tiempo real con la base de datos principal
        </div>
    </main>
</div>
