@{
    ViewData["Title"] = "Panel Administrativo";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var labelsVentas = Html.Raw(Json.Serialize(ViewBag.LabelsVentas));
    var datosVentas = Html.Raw(Json.Serialize(ViewBag.DatosVentas));

    var labelsTop = Html.Raw(Json.Serialize(ViewBag.LabelsTop));
    var datosTop = Html.Raw(Json.Serialize(ViewBag.DatosTop));

    var labelsMetodos = Html.Raw(Json.Serialize(ViewBag.LabelsMetodos));
    var datosMetodos = Html.Raw(Json.Serialize(ViewBag.DatosMetodos));
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --primary: #6c63ff;
        --primary-dark: #574fd6;
        --accent: #00d9b5;
        --bg-dark: #0d0f1a;
        --card-bg: rgba(13,15,26,0.7);
        --text-main: #e8eaf6;
        --text-sub: #9da8c7;
    }

    body { background: var(--bg-dark); color: var(--text-main); }

    .dashboard-header {
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    
    .role-badge {
        display: inline-block;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: #fff;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        padding: 0.3rem 0.85rem;
        border-radius: 50px;
        text-transform: uppercase;
    }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid rgba(108,99,255,0.15);
        border-radius: 16px;
        padding: 1.5rem;
        backdrop-filter: blur(10px);
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: var(--primary);
    }

    .stat-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 1rem;
    }

    .stat-value { font-size: 2rem; font-weight: 800; color: #fff; }
    .stat-label { font-size: 0.85rem; color: var(--text-sub); margin-top: 0.25rem; }

    .chart-container {
        background: var(--card-bg);
        border: 1px solid rgba(108,99,255,0.15);
        border-radius: 16px;
        padding: 1.5rem;
        backdrop-filter: blur(10px);
        height: 100%;
    }

    .chart-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 1rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        padding-bottom: 0.5rem;
    }

    .table-dark-glass {
        width: 100%;
        border-collapse: collapse;
    }
    .table-dark-glass th {
        text-align: left;
        padding: 1rem;
        color: var(--text-sub);
        font-size: 0.8rem;
        text-transform: uppercase;
        border-bottom: 1px solid rgba(108,99,255,0.2);
    }
    .table-dark-glass td {
        padding: 1rem;
        color: #fff;
        font-size: 0.9rem;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .table-dark-glass tr:hover td { background: rgba(255,255,255,0.02); }

    .badge-status {
        padding: 0.2rem 0.6rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
    }
    .bg-success-soft { background: rgba(16,185,129,0.15); color: #10b981; border: 1px solid rgba(16,185,129,0.3); }

    .nav-card {
        background: var(--card-bg);
        border: 1px solid rgba(0,217,181,0.2);
        border-radius: 16px;
        padding: 1.5rem;
        text-decoration: none;
        color: var(--text-main);
        display: block;
        transition: all 0.2s ease;
    }
    .nav-card:hover {
        border-color: #00d9b5;
        background: rgba(0,217,181,0.05);
        color: #fff;
        transform: translateY(-2px);
    }
    .nav-card .nav-icon { font-size: 2rem; margin-bottom: 0.75rem; }

</style>

<div class="container-fluid py-4 px-4">
    
    <div class="dashboard-header">
        <h1 class="h4 m-0 fw-bold">📊 Resumen Operativo</h1>
        @if (ViewBag.SucursalId != null)
        {
            <span class="role-badge" style="font-size:0.65rem;">Sucursal #@ViewBag.SucursalId</span>
        }
    </div>
    
    <!-- Módulos rápidos -->
    <div class="row g-3 mb-4">
        @if (User.IsInRole("GerenteGeneral") || User.IsInRole("Admin"))
        {
            <div class="col-sm-6 col-md-3">
                <a asp-controller="Personal" asp-action="Index" class="nav-card" style="border-color:rgba(167,139,250,0.4);">
                    <div class="nav-icon">👥</div>
                    <div class="fw-bold" style="color:#c4b5fd;">Control de Personal</div>
                    <div style="font-size:0.82rem;color:var(--text-sub)">Asignación de roles y usuarios</div>
                </a>
            </div>
            <div class="col-sm-6 col-md-3">
                <a asp-controller="Sucursales" asp-action="Index" class="nav-card">
                    <div class="nav-icon">🏢</div>
                    <div class="fw-bold">Sucursales</div>
                    <div style="font-size:0.82rem;color:var(--text-sub)">Gestión de red física</div>
                </a>
            </div>
        }
        @if (User.IsInRole("Comercial") || User.IsInRole("GerenteGeneral") || User.IsInRole("Admin"))
        {
            <div class="col-sm-6 col-md-3">
                <a asp-controller="Proveedores" asp-action="Index" class="nav-card">
                    <div class="nav-icon">🚚</div>
                    <div class="fw-bold">Proveedores</div>
                    <div style="font-size:0.82rem;color:var(--text-sub)">Directorio de abastecimiento</div>
                </a>
            </div>
        }
        <div class="col-sm-6 col-md-3">
            <a asp-controller="Reportes" asp-action="Index" class="nav-card">
                <div class="nav-icon">📋</div>
                <div class="fw-bold">Reportes CSV/PDF</div>
                <div style="font-size:0.82rem;color:var(--text-sub)">Descarga de datos financieros</div>
            </a>
        </div>
    </div>

    <!-- KPIs -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(108,99,255,0.15)">📦</div>
                <div class="stat-value">@ViewBag.TotalInventario</div>
                <div class="stat-label">Unidades en inventario</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(0,217,181,0.15)">💰</div>
                <div class="stat-value">$@(((decimal)ViewBag.VentasMes).ToString("N0"))</div>
                <div class="stat-label">Ventas del mes actual</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(255,193,7,0.15)">👥</div>
                <div class="stat-value">@ViewBag.TotalClientes</div>
                <div class="stat-label">Clientes registrados</div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(239,68,68,0.15)">🛒</div>
                <div class="stat-value">@ViewBag.CarritosActivos</div>
                <div class="stat-label">Carritos abandonados</div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="chart-container">
                <div class="chart-title">📈 Tendencia de Ventas (6 Meses)</div>
                <div style="height:300px; position:relative;">
                    <canvas id="ventasChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="chart-container">
                <div class="chart-title">🏆 Top 5 Más Vendidos</div>
                <div style="height:300px; position:relative;">
                    <canvas id="topChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Table & Donut -->
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="chart-container" style="overflow-x:auto;">
                <div class="chart-title">🧾 Últimas Ventas</div>
                <table class="table-dark-glass">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Cliente</th>
                            <th>Fecha y Hora</th>
                            <th>Total</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in (List<EcommerceApp.Models.Pedido>)ViewBag.UltimasVentas)
                        {
                            <tr>
                                <td style="font-family:monospace; color:#00d9b5;">@p.NumeroPedido</td>
                                <td>@(p.Usuario?.NombreCompleto ?? p.Usuario?.Email ?? "N/A")</td>
                                <td>@p.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="font-weight:700;">$@p.Total.ToString("N2")</td>
                                <td>
                                    <span class="badge-status bg-success-soft">@p.Estado</span>
                                </td>
                            </tr>
                        }
                        @if (((List<EcommerceApp.Models.Pedido>)ViewBag.UltimasVentas).Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted">No hay ventas recientes</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="chart-container">
                <div class="chart-title">💳 Métodos de Pago</div>
                <div style="height:250px; position:relative; display:flex; justify-content:center;">
                    <canvas id="metodosChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    // Config general Chart.js para Dark Theme
    Chart.defaults.color = '#9da8c7';
    Chart.defaults.borderColor = 'rgba(255,255,255,0.05)';
    Chart.defaults.font.family = 'Inter, system-ui, sans-serif';

    // 1. Gráfico Líneas (Ventas 6 meses)
    new Chart(document.getElementById('ventasChart'), {
        type: 'line',
        data: {
            labels: @labelsVentas,
            datasets: [{
                label: 'Ingresos Totales ($)',
                data: @datosVentas,
                borderColor: '#6c63ff',
                backgroundColor: 'rgba(108,99,255,0.1)',
                borderWidth: 3,
                pointBackgroundColor: '#00d9b5',
                pointRadius: 4,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' } },
                x: { grid: { display: false } }
            }
        }
    });

    // 2. Gráfico Barras (Top Productos)
    new Chart(document.getElementById('topChart'), {
        type: 'bar',
        data: {
            labels: @labelsTop,
            datasets: [{
                label: 'Unidades Vendidas',
                data: @datosTop,
                backgroundColor: 'rgba(0, 217, 181, 0.7)',
                borderColor: '#00d9b5',
                borderWidth: 1,
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true },
                x: { display: false } // ocultar nombres largos abajo, ver en tooltip
            }
        }
    });

    // 3. Gráfico Dona (Métodos Pago)
    new Chart(document.getElementById('metodosChart'), {
        type: 'doughnut',
        data: {
            labels: @labelsMetodos,
            datasets: [{
                data: @datosMetodos,
                backgroundColor: ['#6c63ff', '#00d9b5', '#f59e0b', '#ef4444', '#8b5cf6'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { color: '#e8eaf6', padding: 15 } }
            },
            cutout: '70%'
        }
    });
</script>
