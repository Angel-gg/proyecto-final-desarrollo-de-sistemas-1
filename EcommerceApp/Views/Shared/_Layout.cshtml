<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — TechParts</title>
    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#6c63ff" />
    <meta name="user-auth" content="@(User.Identity!.IsAuthenticated ? "true" : "false")" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TechParts" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommerceApp.styles.css" asp-append-version="true" />
    <style>
        * { font-family: 'Inter', sans-serif; }

        /* ── Navbar premium ── */
        .tp-navbar {
            background: linear-gradient(90deg, #0d0f1a 0%, #12142a 100%);
            border-bottom: 1px solid rgba(108,99,255,0.25);
            padding: 0.6rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 20px rgba(0,0,0,0.4);
        }

        .tp-brand {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
            font-weight: 800;
            font-size: 1.15rem;
            color: #fff;
        }
        .tp-brand:hover { color: #a78bfa; }

        .tp-brand-icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, #6c63ff, #00d9b5);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
        }

        .tp-nav-links {
            display: flex;
            align-items: center;
            gap: 0.25rem;
            list-style: none;
            margin: 0; padding: 0;
        }

        .tp-nav-links a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            padding: 0.45rem 0.85rem;
            border-radius: 8px;
            transition: all 0.2s;
        }
        .tp-nav-links a:hover {
            color: #fff;
            background: rgba(108,99,255,0.2);
        }

        .tp-nav-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .tp-user-chip {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 50px;
            padding: 0.3rem 0.85rem 0.3rem 0.4rem;
        }

        .tp-user-avatar {
            width: 28px; height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6c63ff, #00d9b5);
            display: flex; align-items: center; justify-content: center;
            font-size: 0.75rem;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .tp-user-name {
            font-size: 0.82rem;
            font-weight: 600;
            color: rgba(255,255,255,0.9);
            max-width: 140px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .tp-role-badge {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            background: linear-gradient(135deg, #6c63ff, #00d9b5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .tp-btn-logout {
            background: rgba(239,68,68,0.12);
            border: 1px solid rgba(239,68,68,0.35);
            color: #f87171;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 0.4rem 0.9rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .tp-btn-logout:hover {
            background: rgba(239,68,68,0.25);
            color: #fca5a5;
            border-color: #f87171;
        }

        .tp-btn-login {
            background: linear-gradient(135deg, #6c63ff, #574fd6);
            border: none;
            color: #fff;
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.45rem 1.1rem;
            border-radius: 8px;
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .tp-btn-login:hover { opacity: 0.85; color: #fff; }

        /* Navbar search */
        .tp-search-form {
            position: relative;
            display: flex;
            align-items: center;
        }
        .tp-search-input {
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.1);
            color: #f3f4f6;
            padding: 0.45rem 1rem 0.45rem 2.5rem;
            border-radius: 8px;
            font-size: 0.85rem;
            width: 240px;
            transition: all 0.2s;
        }
        .tp-search-input:focus {
            background: rgba(255,255,255,0.12);
            border-color: rgba(255,255,255,0.3);
            outline: none;
            width: 280px;
            box-shadow: 0 0 0 3px rgba(255,255,255,0.05);
        }
        .tp-search-icon {
            position: absolute;
            left: 0.85rem;
            color: rgba(255,255,255,0.4);
            font-size: 0.95rem;
            pointer-events: none;
        }

        /* ── Mobile Drawer (Offcanvas) Customization ── */
        @@media (max-width: 767.98px) {
            .navbar-collapse {
                position: fixed;
                top: 0; bottom: 0; right: -100%;
                width: 85%; max-width: 350px;
                /* Solid fallback for Android Chrome where backdrop-filter fails */
                background: #0d0f1a;
                z-index: 1050;
                transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                display: flex !important;
                flex-direction: column;
                border-left: 1px solid rgba(108,99,255,0.25);
                box-shadow: -10px 0 50px rgba(0,0,0,0.9);
                padding: 0;
                overscroll-behavior: contain;
            }
            .navbar-collapse.show { right: 0; }
            /* Progressive enhancement: blur only where supported */
            @@supports (backdrop-filter: blur(1px)) {
                .navbar-collapse { background: rgba(10,12,24,0.98); }
            }
            
            /* Add backdrop overlay when open */
            .mobile-backdrop {
                position: fixed; top:0; left:0; width:100vw; height:100vh;
                background: rgba(0,0,0,0.5); z-index: 1040;
                opacity: 0; pointer-events: none; transition: opacity 0.3s;
            }
            .mobile-backdrop.show { opacity: 1; pointer-events: auto; }

            /* Drawer structure */
            .drawer-header { display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
            .drawer-body { padding: 1.5rem; flex: 1; overflow-y: auto; }
            .drawer-footer { padding: 1.5rem; border-top: 1px solid rgba(255,255,255,0.08); background: rgba(0,0,0,0.2); display: flex; flex-direction: column; gap: 1rem; }
            
            /* Nav list vertical left-aligned */
            .tp-nav-links { flex-direction: column; gap: 0.4rem; align-items: stretch; margin: 1.5rem 0; width: 100%; }
            .tp-nav-links a { 
                padding: 12px 16px; 
                font-size: 0.95rem; 
                border-radius: 8px; 
                display: flex; align-items: center; gap: 12px;
                background: transparent;
                border: 1px solid transparent;
            }
            .tp-nav-links a:hover { background: rgba(255,255,255,0.05); }

            /* Search bar full width */
            .tp-search-form { width: 100%; margin-bottom: 0.5rem; }
            .tp-search-input { width: 100% !important; }

            /* User chip full width */
            .tp-user-chip { width: 100%; background: transparent; border: none; padding: 0; gap: 0.75rem; }
            .tp-user-avatar { width: 36px; height: 36px; font-size: 1rem; }
            .tp-user-name { font-size: 0.95rem; }
            
            .tp-btn-logout { width: 100%; border: 1px solid rgba(239,68,68,0.4); padding: 0.75rem; border-radius: 8px; display: flex; justify-content: center; gap: 0.5rem; align-items: center; }
            .tp-btn-login { width: 100%; display: block; padding: 0.75rem; }

            /* Footer accordions */
            .footer-col h5 { cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
            .footer-col h5::after { content: '+'; font-size: 1.2rem; }
            .footer-col.active h5::after { content: '-'; }
            .footer-col ul { display: none; margin-top: 1rem; }
            .footer-col.active ul { display: block; }
        }
        
        @@media (min-width: 768px) {
            .drawer-header { display: none !important; }
            .drawer-footer { display: flex; align-items: center; gap: 0.75rem; border: none; background: transparent; padding: 0; }
            .drawer-body { display: contents; }
            .tp-search-form { margin-right: 0.5rem; }
            .footer-col ul { display: block !important; }
        }
    </style>
</head>
<body class="tp-global-theme" style="margin:0; padding:0;">

    <!-- Backdrop overlay for mobile drawer -->
    <div class="mobile-backdrop" id="navBackdrop"></div>

    <!-- ── Navbar ── -->
    <nav class="tp-navbar navbar navbar-expand-md navbar-dark">
      <div class="container-fluid px-0">
        <!-- Brand -->
        <a class="tp-brand navbar-brand m-0" asp-controller="Home" asp-action="Index">
            <div class="tp-brand-icon">⚡</div>
            TechParts
        </a>

        <!-- Toggler -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent" style="border-color: rgba(255,255,255,0.1); border-radius: 8px;">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Collapse -->
        <div class="collapse navbar-collapse mt-3 mt-md-0" id="navContent">
            
            <!-- Drawer Header (Mobile Only) -->
            <div class="drawer-header d-md-none">
                <a class="tp-brand m-0" href="/">
                    <div class="tp-brand-icon">⚡</div>
                    TechParts
                </a>
                <button type="button" class="btn-close btn-close-white" data-bs-toggle="collapse" data-bs-target="#navContent"></button>
            </div>

            <!-- Drawer Body -->
            <div class="drawer-body">
                <!-- Mobile Search Form -->
                <form class="tp-search-form d-md-none" action="/Tienda" method="get">
                    <span class="tp-search-icon">🔍</span>
                    <input type="search" name="tipo" class="tp-search-input" placeholder="Buscar SSD, CPU..." />
                </form>

                <!-- Nav links -->
                <ul class="tp-nav-links ms-md-4 mb-0 d-flex flex-column flex-md-row gap-1">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        @if (User.IsInRole("Cliente") || User.IsInRole("User"))
                        {
                            <li><a asp-controller="Tienda" asp-action="Index">🏪 Tienda</a></li>
                            <li>
                                <a asp-controller="Tienda" asp-action="Carrito" id="nav-cart-link" class="d-flex align-items-center gap-2 position-relative" style="color: rgba(255,255,255,0.8); text-decoration: none; padding: 0.4rem 0.8rem; border-radius: 8px; transition: all 0.2s;">
                                    <span style="font-size: 1.1rem;">🛒</span>
                                    <span class="d-none d-md-inline fw-semibold">Carrito</span>
                                    <span id="nav-cart-badge" class="badge bg-danger rounded-pill position-absolute" style="display:none; font-size:0.65rem; top:0px; right:0px; box-shadow: 0 0 0 2px #0d0f1a;">0</span>
                                </a>
                            </li>
                            <li><a asp-controller="Tienda" asp-action="MisPedidos">📦 Pedidos</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Admin" asp-action="Dashboard">📊 Dashboard</a></li>
                            
                            @if (User.IsInRole("GerenteGeneral") || User.IsInRole("GerenteSucursal") || User.IsInRole("Vendedor") || User.IsInRole("Comercial") || User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Componentes" asp-action="Index">🔧 Componentes</a></li>
                            }
                            
                            @if (User.IsInRole("GerenteGeneral") || User.IsInRole("GerenteSucursal") || User.IsInRole("Comercial") || User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Combos" asp-action="Index">🎁 Combos</a></li>
                            }
                            
                            <li><a asp-controller="Tienda" asp-action="Index">🏪 Tienda</a></li>
                            <li><a asp-controller="Tienda" asp-action="MisPedidos">📦 Pedidos</a></li>
                            
                            @if (User.IsInRole("GerenteGeneral") || User.IsInRole("GerenteRegional") || User.IsInRole("GerenteSucursal") || User.IsInRole("Vendedor") || User.IsInRole("Comercial") || User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Reportes" asp-action="Index">📋 Reportes</a></li>
                            }
                            
                            @if (User.IsInRole("GerenteGeneral") || User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Personal" asp-action="Index">👥 Personal</a></li>
                            }
                            
                            @if (User.IsInRole("GerenteGeneral") || User.IsInRole("GerenteRegional") || User.IsInRole("GerenteSucursal") || User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Sucursales" asp-action="Index">🗺️ Sucursales</a></li>
                            }
                            
                            @if (User.IsInRole("Comercial") || User.IsInRole("GerenteGeneral") || User.IsInRole("GerenteRegional") || User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Proveedores" asp-action="Index">🚚 Proveedores</a></li>
                            }
                        }
                    }
                    else
                    {
                        @* Visitantes sin sesión: solo pueden ver la tienda *@
                        <li><a asp-controller="Tienda" asp-action="Index">🏪 Tienda</a></li>
                    }
                </ul>
            </div>

            <!-- Center Search Form Desktop -->
            <form class="tp-search-form d-none d-md-flex mx-auto" action="/Tienda" method="get" style="width: 400px; max-width: 100%;">
                <span class="tp-search-icon">🔍</span>
                <input type="search" name="tipo" class="tp-search-input w-100" placeholder="Buscar RTX 4060, B650, Ryzen 7..." style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2); width: 100% !important;" />
            </form>

            <!-- Drawer Footer / Right Side Desktop -->
            <div class="drawer-footer ms-auto tp-nav-right">
                @if (User.Identity!.IsAuthenticated)
                {
                    <!-- User Dropdown -->
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="background: rgba(255,255,255,0.06); padding: 0.35rem 0.8rem 0.35rem 0.35rem; border-radius: 50px; border: 1px solid rgba(255,255,255,0.1);">
                            <div class="tp-user-avatar me-2" style="width:30px; height:30px;">
                                @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="d-none d-md-block fw-semibold" style="font-size:0.85rem; max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow border-0" aria-labelledby="userDropdown" style="background: rgba(13,15,26,0.95); backdrop-filter: blur(12px); border: 1px solid rgba(108,99,255,0.3) !important; border-radius: 12px; margin-top: 0.5rem;">
                            <li>
                                <div class="px-3 py-2">
                                    <div class="fw-bold" style="font-size: 0.85rem; color: #fff;">@User.Identity.Name</div>
                                    @{
                                        var rolName = User.IsInRole("GerenteGeneral") ? "Gerente General"
                                                    : User.IsInRole("GerenteRegional") ? "Gerente Regional"
                                                    : User.IsInRole("GerenteSucursal") ? "Gerente Sucursal"
                                                    : User.IsInRole("Vendedor") ? "Vendedor"
                                                    : User.IsInRole("Comercial") ? "Comercial"
                                                    : User.IsInRole("Admin") ? "Admin"
                                                    : "Cliente";
                                    }
                                    <div class="tp-role-badge mt-1" style="font-size:0.7rem;">@rolName</div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.1);"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2 fw-semibold" style="font-size:0.85rem;">🚪 Cerrar Sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="tp-btn-login">Iniciar sesión</a>
                }
            </div>
        </div>
      </div>
    </nav>

    <!-- ── Main ── -->
    <div class="tp-main">
        @RenderBody()
    </div>

    <!-- ── Footer ── -->
    <footer class="tp-footer text-start">
        <div class="container-fluid px-4">
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-4 footer-col">
                    <h5 class="text-white mb-3" style="font-size:0.95rem;font-weight:700;">TechParts</h5>
                    <p style="font-size:0.85rem;line-height:1.6;color:rgba(255,255,255,0.6);">
                        Tu aliado en hardware de alto rendimiento. Envíos a todo el país y garantía directa de fábrica.
                    </p>
                </div>
                <div class="col-12 col-md-4 footer-col">
                    <h5 class="text-white mb-3" style="font-size:0.95rem;font-weight:700;">Soporte Técnico</h5>
                    <ul class="list-unstyled" style="font-size:0.85rem;line-height:2;">
                        <li><a href="#">Garantías y Devoluciones</a></li>
                        <li><a href="#">Centro de Ayuda</a></li>
                        <li><a href="#">Estado de mi pedido</a></li>
                        <li><a href="#">Métodos de envío</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-4 footer-col">
                    <h5 class="text-white mb-3" style="font-size:0.95rem;font-weight:700;">Legal</h5>
                    <ul class="list-unstyled" style="font-size:0.85rem;line-height:2;">
                        <li><a href="#">Términos y Condiciones</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Aviso de Privacidad</a></li>
                        <li><a href="#">Políticas de Cookies</a></li>
                    </ul>
                </div>
            </div>
            <div class="text-center pt-4" style="border-top:1px solid rgba(255,255,255,0.1);font-size:0.8rem;color:rgba(255,255,255,0.4);">
                © 2026 TechParts ERP — Desarrollo de Sistemas 1
            </div>
        </div>
    </footer>

    <!-- PWA Install Banner -->
    <div id="pwa-toast" class="pwa-banner" style="display:none; position:fixed; bottom:0; left:0; width:100%; z-index:9999; background:rgba(15,23,42,0.85); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border-top:1px solid rgba(255,255,255,0.1); padding:0.6rem 1rem; box-shadow:0 -5px 25px rgba(0,0,0,0.5);">
        <div class="container-fluid d-flex align-items-center justify-content-between p-0">
            <div class="d-flex align-items-center gap-2">
                <div style="width:28px; height:28px; background:var(--primary); border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0;">⚡</div>
                <div>
                    <h6 class="text-white m-0" style="font-weight:700; font-size:0.85rem;">TechParts App</h6>
                    <p class="m-0" style="font-size:0.75rem; color:#cbd5e1;">Mejor experiencia móvil</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <button type="button" id="btn-pwa-install" class="btn btn-sm text-white" style="background:var(--primary); font-weight:700; border-radius:50px; font-size:0.75rem; padding:0.25rem 1rem;">Instalar</button>
                <button type="button" id="btn-pwa-close" class="btn-close btn-close-white" style="font-size:0.75rem;" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Footer accordion logic for mobile
        $(document).ready(function() {
            if ($(window).width() <= 768) {
                $('.footer-col h5').click(function() {
                    $(this).parent().toggleClass('active');
                    $(this).parent().siblings().removeClass('active');
                });
            }

            // Mobile Backdrop logic for drawer
            const navCollapse = document.getElementById('navContent');
            const navBackdrop = document.getElementById('navBackdrop');
            if (navCollapse && navBackdrop) {
                navCollapse.addEventListener('show.bs.collapse', function () {
                    if (window.innerWidth < 768) navBackdrop.classList.add('show');
                });
                navCollapse.addEventListener('hide.bs.collapse', function () {
                    navBackdrop.classList.remove('show');
                });
                navBackdrop.addEventListener('click', function() {
                    const bsCollapse = bootstrap.Collapse.getInstance(navCollapse);
                    if (bsCollapse) bsCollapse.hide();
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    @* ── Web Speech API (todos los usuarios, autenticados o no) ── *@
    <script src="~/js/speech.js" asp-append-version="true"></script>

    @* ── PWA Service Worker Registration ── *@
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('[PWA] Service Worker registrado:', reg.scope))
                    .catch(err => console.warn('[PWA] Error registrando SW:', err));
            });
        }

        // PWA Install Logic
        let deferredPrompt;
        const pwaToast = document.getElementById('pwa-toast');
        const btnPwaInstall = document.getElementById('btn-pwa-install');
        const btnPwaClose = document.getElementById('btn-pwa-close');

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            
            if (sessionStorage.getItem('pwaPromptClosed')) return;

            if (pwaToast) {
                pwaToast.style.display = 'block';
                pwaToast.classList.add('show');
            }
        });

        if (btnPwaInstall) {
            btnPwaInstall.addEventListener('click', async () => {
                if (deferredPrompt !== null) {
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    console.log(`User response to the install prompt: ${outcome}`);
                    deferredPrompt = null;
                    if (pwaToast) pwaToast.style.display = 'none';
                }
            });
        }
        
        if (btnPwaClose) {
            btnPwaClose.addEventListener('click', () => {
                if (pwaToast) pwaToast.style.display = 'none';
                sessionStorage.setItem('pwaPromptClosed', 'true');
            });
        }

        window.addEventListener('appinstalled', () => {
            deferredPrompt = null;
            if (pwaToast) pwaToast.style.display = 'none';
            console.log('PWA was installed');
        });

        // ── JS for Cart Count Badge ──
        $(document).ready(function() {
            var cartLink = $('#nav-cart-link');
            if (cartLink.length) {
                $.get('/Tienda/CarritoCount', function(data) {
                    if (data && data.count > 0) {
                        $('#nav-cart-badge').text(data.count).show();
                    }
                });
            }
        });
    </script>
</body>
</html>
