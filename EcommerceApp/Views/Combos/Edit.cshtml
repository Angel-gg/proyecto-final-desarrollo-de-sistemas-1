@model EcommerceApp.Models.Combo
@{
    ViewData["Title"] = $"Editar: {Model.Nombre}";
    var componentes = ViewBag.Componentes as List<EcommerceApp.Models.Componente> ?? new();
    var seleccionados = Model.ComboComponentes.ToDictionary(cc => cc.ComponenteId, cc => cc.Cantidad);
}

<style>
    body { background: #0d0f1a !important; }
    .form-page { max-width: 820px; margin: 2.5rem auto; padding: 0 1.5rem 4rem; }
    .form-card {
        background: rgba(255,255,255,0.04); border: 1px solid rgba(251,191,36,0.2);
        border-radius: 20px; padding: 2.5rem;
    }
    .form-card h2 { color: #fff; font-weight: 800; font-size: 1.5rem; margin: 0 0 0.4rem; }
    .form-subtitle { color: rgba(255,255,255,0.45); font-size: 0.88rem; margin-bottom: 2rem; }
    .edit-badge {
        display: inline-block; background: rgba(251,191,36,0.12);
        border: 1px solid rgba(251,191,36,0.3); color: #fbbf24;
        font-size: 0.75rem; font-weight: 700; padding: 0.2rem 0.65rem; border-radius: 50px; margin-bottom: 0.4rem;
    }
    .form-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 1.75rem 0; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @@media(max-width:600px){ .form-row { grid-template-columns: 1fr; } }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; color: rgba(255,255,255,0.7); font-size: 0.82rem; font-weight: 600; margin-bottom: 0.45rem; letter-spacing: 0.04em; }
    .form-control-tp {
        width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
        border-radius: 10px; padding: 0.65rem 0.95rem; color: #fff; font-size: 0.9rem;
        outline: none; transition: border-color 0.2s; box-sizing: border-box;
    }
    .form-control-tp:focus { border-color: #fbbf24; background: rgba(251,191,36,0.05); }
    .form-control-tp::placeholder { color: rgba(255,255,255,0.25); }
    textarea.form-control-tp { resize: vertical; min-height: 90px; }
    .form-error { color: #f87171; font-size: 0.78rem; margin-top: 0.35rem; }
    .section-label { color: rgba(255,255,255,0.8); font-size: 1rem; font-weight: 700; margin-bottom: 1rem; }
    .comp-selector { display: flex; flex-direction: column; gap: 0.6rem; max-height: 380px; overflow-y: auto; }
    .comp-selector::-webkit-scrollbar { width: 6px; }
    .comp-selector::-webkit-scrollbar-thumb { background: rgba(251,191,36,0.4); border-radius: 3px; }
    .comp-row {
        display: grid; grid-template-columns: auto 1fr auto;
        align-items: center; gap: 0.75rem;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px; padding: 0.75rem 1rem; transition: border-color 0.18s;
    }
    .comp-row label { color: rgba(255,255,255,0.8); font-size: 0.88rem; cursor: pointer; }
    .comp-price { color: #fbbf24; font-weight: 700; font-size: 0.85rem; white-space: nowrap; }
    .comp-type-tag { font-size: 0.7rem; color: rgba(255,255,255,0.35); background: rgba(255,255,255,0.05); border-radius: 4px; padding: 0.1rem 0.4rem; margin-left: 0.4rem; }
    .qty-input {
        width: 60px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
        border-radius: 8px; padding: 0.3rem 0.5rem; color: #fff; font-size: 0.85rem; text-align: center;
    }
    input[type=checkbox] { accent-color: #fbbf24; width: 16px; height: 16px; cursor: pointer; }
    .check-row { display: flex; align-items: center; gap: 0.5rem; }
    .toggle-label { color: rgba(255,255,255,0.65); font-size: 0.88rem; }
    input[type=checkbox].toggle { accent-color: #00d9b5; width: 18px; height: 18px; }
    .preview-img { width: 100%; height: 140px; border-radius: 12px; object-fit: cover; border: 1px solid rgba(255,255,255,0.1); margin-top: 0.5rem; }
    .form-actions { display: flex; gap: 0.75rem; margin-top: 1.75rem; }
    .btn-save {
        flex: 1; background: linear-gradient(135deg, #fbbf24, #d97706);
        border: none; color: #0d0f1a; font-weight: 700; font-size: 0.95rem;
        padding: 0.75rem 1.5rem; border-radius: 12px; cursor: pointer; transition: opacity 0.2s;
    }
    .btn-save:hover { opacity: 0.85; }
    .btn-cancel {
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.6); font-weight: 600; padding: 0.75rem 1.25rem;
        border-radius: 12px; text-decoration: none; text-align: center; transition: all 0.2s;
    }
    .btn-cancel:hover { background: rgba(255,255,255,0.1); color: #fff; }
</style>

<div class="form-page">
    <div class="form-card">
        <span class="edit-badge">✏️ Editando</span>
        <h2>@Model.Nombre</h2>
        <p class="form-subtitle">Modifica el combo — ID #@Model.Id</p>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreadoEn" />
            <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom:1rem;"></div>

            <div class="form-group">
                <label asp-for="Nombre" class="form-label">Nombre del Combo *</label>
                <input asp-for="Nombre" class="form-control-tp" />
                <span asp-validation-for="Nombre" class="form-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Descripcion" class="form-label">Descripción *</label>
                <textarea asp-for="Descripcion" class="form-control-tp"></textarea>
                <span asp-validation-for="Descripcion" class="form-error"></span>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="PrecioVenta" class="form-label">Precio de Venta (MXN) *</label>
                    <input asp-for="PrecioVenta" class="form-control-tp" type="number" step="0.01" />
                    <span asp-validation-for="PrecioVenta" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Stock" class="form-label">Stock disponible</label>
                    <input asp-for="Stock" class="form-control-tp" type="number" min="0" />
                </div>
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl" class="form-label">URL de imagen</label>
                <input asp-for="ImageUrl" class="form-control-tp" id="imgUrlInput" />
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img id="imgPreview" src="@Model.ImageUrl" class="preview-img" alt="Imagen" />
                }
                else
                {
                    <img id="imgPreview" class="preview-img" style="display:none;" alt="Vista previa" />
                }
            </div>
            <div class="form-group">
                <div class="check-row">
                    <input asp-for="Activo" type="checkbox" class="toggle" />
                    <span class="toggle-label">Combo activo (visible en tienda)</span>
                </div>
            </div>

            <div class="form-divider"></div>
            <div class="section-label">📦 Componentes incluidos</div>

            <div class="comp-selector">
                @foreach (var c in componentes)
                {
                    var isChecked = seleccionados.ContainsKey(c.Id);
                    var qty = isChecked ? seleccionados[c.Id] : 1;
                    <div class="comp-row">
                        <input type="checkbox" name="ComponenteIds" value="@c.Id" id="comp_@c.Id"
                               @(isChecked ? "checked" : "") />
                        <label for="comp_@c.Id">
                            @c.Nombre <span class="comp-type-tag">@c.Tipo</span>
                        </label>
                        <div style="display:flex;align-items:center;gap:0.5rem;">
                            <span class="comp-price">$@c.Precio.ToString("N0")</span>
                            <input type="number" name="Cantidades" value="@qty" min="1" max="99"
                                   class="qty-input" style="display:@(isChecked ? "block" : "none")" />
                        </div>
                    </div>
                }
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">💾 Guardar Cambios</button>
                <a asp-action="Index" class="btn-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const urlInput = document.getElementById('imgUrlInput');
        const preview = document.getElementById('imgPreview');
        urlInput?.addEventListener('input', () => {
            const url = urlInput.value.trim();
            if (url) { preview.src = url; preview.style.display = 'block'; preview.onerror = () => preview.style.display = 'none'; }
            else { preview.style.display = 'none'; }
        });
        document.querySelectorAll('.comp-row input[type=checkbox]').forEach(cb => {
            const row = cb.closest('.comp-row');
            const qty = row.querySelector('.qty-input');
            cb.addEventListener('change', () => { qty.style.display = cb.checked ? 'block' : 'none'; });
        });
    </script>
}
