@model EcommerceApp.Models.Combo
@{
    ViewData["Title"] = "Nuevo Combo — TechParts ERP";
    var componentes = ViewBag.Componentes as List<EcommerceApp.Models.Componente> ?? new();
}

<style>
    body { background: #0d0f1a !important; }
    .form-page { max-width: 820px; margin: 2.5rem auto; padding: 0 1.5rem 4rem; }
    .form-card {
        background: rgba(255,255,255,0.04); border: 1px solid rgba(0,217,181,0.2);
        border-radius: 20px; padding: 2.5rem;
    }
    .form-card h2 { color: #fff; font-weight: 800; font-size: 1.5rem; margin: 0 0 0.4rem; }
    .form-subtitle { color: rgba(255,255,255,0.45); font-size: 0.88rem; margin-bottom: 2rem; }
    .form-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 1.75rem 0; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @@media(max-width:600px){ .form-row { grid-template-columns: 1fr; } }
    .form-group { margin-bottom: 1.25rem; }
    .form-label {
        display: block; color: rgba(255,255,255,0.7);
        font-size: 0.82rem; font-weight: 600; margin-bottom: 0.45rem; letter-spacing: 0.04em;
    }
    .form-control-tp {
        width: 100%; background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12); border-radius: 10px;
        padding: 0.65rem 0.95rem; color: #fff; font-size: 0.9rem;
        outline: none; transition: border-color 0.2s; box-sizing: border-box;
    }
    .form-control-tp:focus { border-color: #00d9b5; background: rgba(0,217,181,0.06); }
    .form-control-tp::placeholder { color: rgba(255,255,255,0.25); }
    textarea.form-control-tp { resize: vertical; min-height: 90px; }

    /* Selector de componentes */
    .section-label {
        color: rgba(255,255,255,0.8); font-size: 1rem; font-weight: 700; margin-bottom: 1rem;
        display: flex; align-items: center; gap: 0.5rem;
    }
    .comp-selector { display: flex; flex-direction: column; gap: 0.6rem; max-height: 380px; overflow-y: auto; }
    .comp-selector::-webkit-scrollbar { width: 6px; }
    .comp-selector::-webkit-scrollbar-track { background: rgba(255,255,255,0.04); }
    .comp-selector::-webkit-scrollbar-thumb { background: rgba(108,99,255,0.4); border-radius: 3px; }

    .comp-row {
        display: grid; grid-template-columns: auto 1fr auto;
        align-items: center; gap: 0.75rem;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px; padding: 0.75rem 1rem;
        transition: border-color 0.18s;
    }
    .comp-row:has(input[type=checkbox]:checked) {
        border-color: rgba(0,217,181,0.35); background: rgba(0,217,181,0.05);
    }
    .comp-row label { color: rgba(255,255,255,0.8); font-size: 0.88rem; cursor: pointer; }
    .comp-row .comp-price { color: #00d9b5; font-weight: 700; font-size: 0.85rem; white-space: nowrap; }

    .qty-input {
        width: 60px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
        border-radius: 8px; padding: 0.3rem 0.5rem; color: #fff; font-size: 0.85rem;
        text-align: center; display: none;
    }
    input[type=checkbox]:checked ~ .qty-input { display: block; }
    input[type=checkbox] { accent-color: #00d9b5; width: 16px; height: 16px; cursor: pointer; }

    .comp-type-tag {
        font-size: 0.7rem; color: rgba(255,255,255,0.35);
        background: rgba(255,255,255,0.05); border-radius: 4px; padding: 0.1rem 0.4rem;
        margin-left: 0.4rem;
    }

    .form-error { color: #f87171; font-size: 0.78rem; margin-top: 0.35rem; }
    .form-actions { display: flex; gap: 0.75rem; margin-top: 1.75rem; }
    .btn-save {
        flex: 1; background: linear-gradient(135deg, #00d9b5, #00a89a);
        border: none; color: #0d0f1a; font-weight: 700; font-size: 0.95rem;
        padding: 0.75rem 1.5rem; border-radius: 12px; cursor: pointer; transition: opacity 0.2s;
    }
    .btn-save:hover { opacity: 0.85; }
    .btn-cancel {
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.6); font-weight: 600; font-size: 0.9rem;
        padding: 0.75rem 1.25rem; border-radius: 12px; text-decoration: none; text-align: center;
        transition: all 0.2s;
    }
    .btn-cancel:hover { background: rgba(255,255,255,0.1); color: #fff; }

    .preview-img { width: 100%; height: 140px; border-radius: 12px; object-fit: cover;
        border: 1px solid rgba(255,255,255,0.1); margin-top: 0.5rem; display: none; }

    .check-row { display: flex; align-items: center; gap: 0.5rem; }
    .toggle-label { color: rgba(255,255,255,0.65); font-size: 0.88rem; }
    input[type=checkbox].toggle { accent-color: #00d9b5; width: 18px; height: 18px; }
</style>

<div class="form-page">
    <div class="form-card">
        <h2>+ Nuevo Combo</h2>
        <p class="form-subtitle">Crea un paquete de componentes con precio especial</p>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom:1rem;"></div>

            <div class="form-group">
                <label asp-for="Nombre" class="form-label">Nombre del Combo *</label>
                <input asp-for="Nombre" class="form-control-tp" placeholder="Ej: Gaming PC Starter Pack" />
                <span asp-validation-for="Nombre" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descripcion" class="form-label">Descripción *</label>
                <textarea asp-for="Descripcion" class="form-control-tp" placeholder="Describe qué incluye y para qué tipo de usuario es ideal..."></textarea>
                <span asp-validation-for="Descripcion" class="form-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="PrecioVenta" class="form-label">Precio de Venta (MXN) *</label>
                    <input asp-for="PrecioVenta" class="form-control-tp" type="number" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="PrecioVenta" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Stock" class="form-label">Stock disponible</label>
                    <input asp-for="Stock" class="form-control-tp" type="number" min="0" value="0" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="ImageUrl" class="form-label">URL de imagen</label>
                    <input asp-for="ImageUrl" class="form-control-tp" id="imgUrlInput" placeholder="https://..." />
                    <img id="imgPreview" class="preview-img" alt="Vista previa" />
                </div>
            </div>

            <div class="form-group">
                <div class="check-row">
                    <input asp-for="Activo" type="checkbox" class="toggle" checked />
                    <span class="toggle-label">Combo activo (visible en tienda)</span>
                </div>
            </div>

            <div class="form-divider"></div>

            <div class="section-label">📦 Selecciona los Componentes</div>
            @if (!componentes.Any())
            {
                <p style="color:rgba(255,255,255,0.3); font-size:0.88rem;">
                    No hay componentes. <a asp-controller="Componentes" asp-action="Create" style="color:#6c63ff;">Agrega uno primero</a>.
                </p>
            }
            else
            {
                <div class="comp-selector">
                    @for (int i = 0; i < componentes.Count; i++)
                    {
                        var c = componentes[i];
                        <div class="comp-row">
                            <input type="checkbox" name="ComponenteIds" value="@c.Id" id="comp_@c.Id" />
                            <label for="comp_@c.Id">
                                @c.Nombre
                                <span class="comp-type-tag">@c.Tipo</span>
                            </label>
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <span class="comp-price">$@c.Precio.ToString("N0")</span>
                                <input type="number" name="Cantidades" value="1" min="1" max="99"
                                       class="qty-input" title="Cantidad" />
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="btn-save">🎁 Crear Combo</button>
                <a asp-action="Index" class="btn-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Mostrar preview de imagen
        const urlInput = document.getElementById('imgUrlInput');
        const preview = document.getElementById('imgPreview');
        urlInput?.addEventListener('input', () => {
            const url = urlInput.value.trim();
            if (url) { preview.src = url; preview.style.display = 'block'; preview.onerror = () => preview.style.display = 'none'; }
            else { preview.style.display = 'none'; }
        });

        // Mostrar/ocultar input cantidad al marcar checkbox
        document.querySelectorAll('.comp-row input[type=checkbox]').forEach(cb => {
            const row = cb.closest('.comp-row');
            const qtyInput = row.querySelector('.qty-input');
            cb.addEventListener('change', () => {
                qtyInput.style.display = cb.checked ? 'block' : 'none';
            });
        });
    </script>
}
