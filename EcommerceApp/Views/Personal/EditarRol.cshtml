@model EcommerceApp.Models.ApplicationUser
@{
    ViewData["Title"] = "Editar Roles";
    var rolesDisp = ViewBag.RolesDisponibles as string[] ?? Array.Empty<string>();
    var currentRoles = ViewBag.CurrentRoles as IList<string> ?? new List<string>();
}
<style>
    body { background: #080a14; }
    .form-container { max-width: 600px; margin: 2rem auto; background: rgba(13,15,26,0.7); border: 1px solid rgba(167,139,250,0.2); border-radius: 16px; padding: 2rem; backdrop-filter: blur(10px); }
    .form-title { font-size: 1.5rem; font-weight: 800; color: #fff; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; display:flex; align-items:center; gap:0.5rem; }
    .user-badge { background:rgba(255,255,255,0.05);border-radius:12px;padding:1rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:1rem; }
    .avatar-lg { width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#a78bfa,#6c63ff);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.5rem;color:#fff; }
    .roles-grid { display:grid;grid-template-columns:1fr 1fr;gap:1rem; }
    .role-check-card { background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:1rem;display:flex;align-items:center;gap:0.75rem;cursor:pointer;transition:all 0.2s; }
    .role-check-card:hover { background:rgba(255,255,255,0.07);border-color:rgba(167,139,250,0.4); }
    .role-check-card.active { background:rgba(167,139,250,0.15);border-color:#a78bfa; }
    .role-checkbox { width:20px;height:20px;accent-color:#a78bfa;cursor:pointer; }
    .role-name { font-weight:600;color:#e0e0ff;font-size:0.95rem; }
    .btn-submit { background: linear-gradient(135deg, #a78bfa, #6c63ff); color: #fff; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 700; width: 100%; cursor: pointer; transition: opacity 0.2s; margin-top:2rem; }
    .btn-submit:hover { opacity: 0.9; }
    .btn-cancel { display: block; text-align: center; color: rgba(200,200,255,0.6); margin-top: 1rem; text-decoration: none; font-size: 0.85rem; }
    .btn-cancel:hover { color: #fff; }
    .alert-msg { padding:0.85rem 1.25rem;border-radius:10px;font-size:0.88rem;font-weight:600;margin-bottom:1.5rem; }
    .alert-err { background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);color:#fca5a5; }
</style>

<div class="form-container">
    <div class="form-title">✏️ Asignar Roles</div>
    
    @if (TempData["Error"] != null)
    {
        <div class="alert-msg alert-err">⚠ @TempData["Error"]</div>
    }

    <div class="user-badge">
        <div class="avatar-lg">@(!string.IsNullOrEmpty(Model.Email) ? Model.Email.Substring(0,1).ToUpper() : "?")</div>
        <div>
            <div style="font-weight:800;color:#fff;font-size:1.1rem;">@(Model.NombreCompleto ?? Model.FullName ?? "Sin Nombre")</div>
            <div style="color:rgba(200,200,255,0.6);font-size:0.9rem;">@Model.Email</div>
            @if (!string.IsNullOrEmpty(Model.CodigoCliente)) { <div style="color:#00d9b5;font-size:0.8rem;font-weight:700;">Código: @Model.CodigoCliente</div> }
        </div>
    </div>

    <form asp-action="GuardarRoles" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        
        <div style="font-size:0.9rem;color:rgba(200,200,255,0.7);margin-bottom:1rem;font-weight:600;">Selecciona los roles para este usuario:</div>
        
        <div class="roles-grid">
            @foreach (var r in rolesDisp)
            {
                var isChecked = currentRoles.Contains(r);
                <label class="role-check-card @(isChecked ? "active" : "")">
                    <input type="checkbox" name="selectedRoles" value="@r" class="role-checkbox" @(isChecked ? "checked" : "") />
                    <span class="role-name">@r</span>
                </label>
            }
        </div>

        <button type="submit" class="btn-submit">Guardar Roles</button>
        <a asp-action="Index" class="btn-cancel">Cancelar y Volver</a>
    </form>
</div>

<script>
    document.querySelectorAll('.role-checkbox').forEach(cb => {
        cb.addEventListener('change', function() {
            if(this.checked) this.closest('.role-check-card').classList.add('active');
            else this.closest('.role-check-card').classList.remove('active');
        });
    });
</script>
